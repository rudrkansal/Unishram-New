rules_version = '2';

// UniShram security rules.
//
// Principle: a signed-in user may read what the marketplace needs them to see,
// but may only write their own documents. Anything that must be trustworthy —
// application counts, ratings, verification flags, suspensions — is written by
// Cloud Functions with the Admin SDK, never by a client.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function unchanged(field) {
      return !(field in request.resource.data) ||
             (resource != null && request.resource.data[field] == resource.data[field]);
    }
    function isPlainText(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }

    // True if the other participant in this thread has blocked [sender] —
    // enforced here, not just filtered in the UI, so a blocked user genuinely
    // cannot get a new message through.
    function threadBlockedFor(threadId, sender) {
      let thread = get(/databases/$(database)/documents/threads/$(threadId)).data;
      let other = thread.participants[0] == sender
          ? thread.participants[1] : thread.participants[0];
      return exists(/databases/$(database)/documents/users/$(other)/blocks/$(sender));
    }

    // True if the job application tied to this thread was rejected — chat
    // history stays visible, but neither side may send anything new until
    // the application is legitimately reopened (status moves off 'rejected').
    function threadApplicationRejected(threadId) {
      let thread = get(/databases/$(database)/documents/threads/$(threadId)).data;
      let jobId = thread.get('jobId', null);
      let p0 = jobId == null ? null : jobId + '_' + thread.participants[0];
      let p1 = jobId == null ? null : jobId + '_' + thread.participants[1];
      return jobId != null && (
        (exists(/databases/$(database)/documents/applications/$(p0)) &&
         get(/databases/$(database)/documents/applications/$(p0)).data.status == 'rejected') ||
        (exists(/databases/$(database)/documents/applications/$(p1)) &&
         get(/databases/$(database)/documents/applications/$(p1)).data.status == 'rejected')
      );
    }

    // Stricter than unchanged(), used by the threads, applications, users and jobs update rules: the field must have the
    // same value *and presence* before and after. unchanged() passes when the
    // field is absent from the resulting document, which lets an update
    // delete it (e.g. removing jobId to dodge the rejected-application check).
    function fieldKept(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // [jobId] must be a job with a poster, the caller must hold a live
    // (pending / shortlisted / hired — not withdrawn or rejected) application
    // for it, and the participants must be exactly the caller and the poster.
    function canOpenJobThread(jobId, participants) {
      let appPath = /databases/$(database)/documents/applications/$(jobId + '_' + request.auth.uid);
      let jobPath = /databases/$(database)/documents/jobs/$(jobId);
      return exists(appPath) && exists(jobPath)
        && get(appPath).data.get('status', null) in ['pending', 'shortlisted', 'hired']
        && get(jobPath).data.get('postedBy', null) is string
        && get(jobPath).data.postedBy != request.auth.uid
        && request.auth.uid in participants
        && get(jobPath).data.postedBy in participants;
    }

    match /users/{uid} {
      // Profiles are visible to signed-in users: a contractor has to be able to
      // look at a worker before hiring them.
      allow read: if signedIn();

      allow create: if isSelf(uid)
        && request.resource.data.role in ['labourer', 'contractor', 'client', 'vendor']
        // 300, not 100: isPlainText's size() counts UTF-8 *bytes*, and
        // Devanagari/Gurmukhi/Telugu/etc. characters run ~3 bytes each — a
        // 100-byte cap silently rejects a full Indian name (first + middle/
        // father's + last) in most of this app's own languages, at exactly
        // the step that creates the account.
        && isPlainText(request.resource.data.fullName, 300)
        // Trust flags are server-owned from the very first write.
        && request.resource.data.get('suspended', false) == false
        && request.resource.data.get('ratingAverage', 0) == 0
        && request.resource.data.get('ratingCount', 0) == 0
        // The phone number lives in users/{uid}/private/contact, never on this
        // publicly readable profile.
        && request.resource.data.get('phone', '') == '';

      allow update: if isSelf(uid)
        && isPlainText(request.resource.data.get('fullName', ''), 300)
        && fieldKept('suspended')
        && fieldKept('ratingAverage')
        && fieldKept('ratingCount')
        && fieldKept('role')
        // No new/changed phone on the public profile (a legacy value may stay
        // until it is migrated, or be removed, but not be set or edited).
        && (request.resource.data.get('phone', '') == ''
            || request.resource.data.get('phone', null) == resource.data.get('phone', null))
        // Only the onJobPosted function may move this — a client resetting
        // its own cooldown would defeat the point of having one.
        && fieldKept('lastJobPostedAt');

      // Deletion runs through the callable function so the user's jobs,
      // applications and photos go with it.
      allow delete: if false;

      // Private contact details: only the owner can read or write them. Other
      // users get a contractor's number solely via contractorContacts/{jobId}.
      match /private/{docId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && docId == 'contact'
          && request.resource.data.keys().hasOnly(['phone', 'updatedAt'])
          && isPlainText(request.resource.data.get('phone', ''), 20);
        allow delete: if false;
      }

      match /tokens/{token} {
        allow read, write: if isSelf(uid);
      }
      // Who this user has blocked. Only they may see or change their own
      // block list, but the message-create rule below reads across users'
      // block lists to enforce blocking, not just filter it client-side.
      match /blocks/{blockedUid} {
        allow read, write: if isSelf(uid);
      }
    }

    // Contractor contact info: only readable by contractor or approved applicants
    match /contractorContacts/{jobId} {
      allow read: if signedIn() && (
        // Contractor can see their own contact info
        resource.data.contractorId == request.auth.uid ||
        // Applicant can see if hired/shortlisted
        exists(/databases/$(database)/documents/applications/$(jobId + '_' + request.auth.uid)) &&
        get(/databases/$(database)/documents/applications/$(jobId + '_' + request.auth.uid)).data.status in ['hired', 'shortlisted']
      );
      allow write: if false; // Admin only, via Cloud Function
    }

    match /jobs/{jobId} {
      // Contractor phone removed from public job document; fetch from contractorContacts instead
      allow read: if signedIn();

      // Jobs are created only by the `postJob` Cloud Function (Admin SDK), which validates the payload and
      // enforces the post cooldown transactionally. Clients cannot create jobs directly.
      allow create: if false;

      // The poster may edit their own job but never its applicant tally or postedBy.
      allow update: if signedIn()
        && resource.data.postedBy == request.auth.uid
        && fieldKept('postedBy')
        && fieldKept('applicantCount')
        // No new/changed phone on the public job (a legacy value may stay until
        // it is migrated, or be removed, but not be set or edited).
        && (request.resource.data.get('contractorPhone', '') == ''
            || request.resource.data.get('contractorPhone', null) == resource.data.get('contractorPhone', null));

      allow delete: if signedIn() && resource.data.postedBy == request.auth.uid;
    }

    match /applications/{applicationId} {
      // Only the two parties to an application can see it.
      allow read: if signedIn()
        && (resource.data.workerId == request.auth.uid
            || resource.data.contractorId == request.auth.uid);

      // The id is jobId_workerId, which makes a second application impossible.
      allow create: if signedIn()
        && request.resource.data.workerId == request.auth.uid
        && applicationId == request.resource.data.jobId + '_' + request.auth.uid
        && request.resource.data.status == 'pending'
        // contractorId is the job's real poster, never caller-chosen.
        && exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId))
        && request.resource.data.get('contractorId', null) ==
           get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.get('postedBy', null);

      // The worker may withdraw; the contractor may shortlist, reject or hire.
      allow update: if signedIn()
        && ((resource.data.workerId == request.auth.uid
             && request.resource.data.status == 'withdrawn')
            || (resource.data.contractorId == request.auth.uid
                && request.resource.data.status in ['pending', 'shortlisted', 'rejected', 'hired']))
        && fieldKept('jobId') && fieldKept('workerId') && fieldKept('contractorId');

      allow delete: if false;
    }

    match /threads/{threadId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;

      // A job thread may only be opened by an applicant whose application is
      // still live, and only with that job's actual poster.
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.jobId is string
        && canOpenJobThread(request.resource.data.jobId, request.resource.data.participants);

      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && fieldKept('participants')
        && fieldKept('jobId')
        && fieldKept('createdAt');
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participants;

        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && isPlainText(request.resource.data.text, 2000)
          && request.resource.data.text.size() > 0
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participants
          && !threadBlockedFor(threadId, request.auth.uid)
          && !threadApplicationRejected(threadId);

        // A sent message cannot be rewritten after the fact.
        allow update, delete: if false;
      }
    }

    match /listings/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.vendorId == request.auth.uid
        && isPlainText(request.resource.data.item, 300)
        && request.resource.data.price is int
        && request.resource.data.price > 0;
      allow update, delete: if signedIn() && resource.data.vendorId == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      // Ratings are recomputed by a function; a review cannot be edited later.
      allow create: if signedIn()
        && request.resource.data.byUserId == request.auth.uid
        && request.resource.data.aboutUserId != request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && isPlainText(request.resource.data.get('comment', ''), 1000);
      allow update, delete: if false;
    }

    match /appRatings/{uid} {
      // One doc per user, id == their own uid, so a rating is an upsert
      // rather than an ever-growing list — feedback on the app itself, not
      // on another user. Only the owner can read their own doc — enough to
      // let the app check "have I already rated this?" before showing the
      // auto-prompt again, without exposing anyone's feedback to others.
      allow read: if isSelf(uid);
      allow create, update: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && isPlainText(request.resource.data.get('comment', ''), 1000);
      allow delete: if false;
    }

    match /reports/{reportId} {
      // Abuse reports: write-only from clients, read by moderators via console.
      allow create: if signedIn()
        && request.resource.data.byUserId == request.auth.uid
        && request.resource.data.reasons is list
        && request.resource.data.reasons.size() > 0;
      allow read, update, delete: if false;
    }

    // Moderator-maintained values the app reads before login exists (minimum
    // wage on the onboarding wage screen). Readable by anyone, writable only
    // from the console/Admin SDK.
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
